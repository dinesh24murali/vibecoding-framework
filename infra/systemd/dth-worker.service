[Unit]
Description=Village DTH Worker Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=dth
Group=dth
WorkingDirectory=/opt/dth/current/backend
EnvironmentFile=/etc/dth/dth.env
ExecStart=/opt/dth/current/bin/dth-worker
Restart=always
RestartSec=5
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dth-worker

[Install]
WantedBy=multi-user.target
